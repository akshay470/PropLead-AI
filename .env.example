# Remote PostgreSQL connection string (Neon / Supabase with sslmode=require)
DATABASE_URL=

# Secret key for signing session JWT cookies (minimum 32 characters)
JWT_SECRET=

# Shared secret token for authenticating automated reminder cron invocations (minimum 16 characters)
CRON_SECRET=

# AI LLM provider selection ("mock" for deterministic offline tests, "gemini" for live Google Gemini)
LLM_PROVIDER=

# Google Gemini model identifier (e.g. "gemini-1.5-flash")
LLM_MODEL=

# Google Gemini API key from Google AI Studio (required if LLM_PROVIDER=gemini)
LLM_API_KEY=

# Public flag enabling pre-filled reviewer credentials on login screen ("true" or "false")
NEXT_PUBLIC_DEMO_MODE=

# Safety guard flag allowing database seed script to execute ("true" or "false")
ALLOW_SEED=

# Optional PostgreSQL connection URL to run multi-connection pool concurrency tests
TEST_DATABASE_URL=

# Canonical application URL used for calendar .ics and notification links
APP_URL=

# Application environment ("development", "test", or "production")
NODE_ENV=
